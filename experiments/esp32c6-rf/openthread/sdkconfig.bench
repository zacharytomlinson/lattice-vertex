# Lattice bench: native USB, no network auto-start, fixed 20 dBm test ceiling.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_COLORS=n
CONFIG_OPENTHREAD_NETWORK_AUTO_START=n
CONFIG_OPENTHREAD_STATE_INDICATOR_ENABLE=n
CONFIG_OPENTHREAD_CLI_ESP_EXTENSION=n
CONFIG_OPENTHREAD_DIAG=y
CONFIG_ESP_PHY_MAX_TX_POWER=20
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=20
